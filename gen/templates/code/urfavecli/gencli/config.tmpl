	if data, err := os.ReadFile(expandTilde({{goString .ConfigJSON}})); err == nil {
		var cfg map[string]any
		if err := json.Unmarshal(data, &cfg); err == nil {
			globalConfig = cfg
			return
		}
	}
{{- end}}
{{- if .ConfigYAML}}
	// Try YAML config
	if data, err := os.ReadFile(expandTilde({{goString .ConfigYAML}})); err == nil {
		var cfg map[string]any
		if err := yaml.Unmarshal(data, &cfg); err == nil {
			globalConfig = cfg
			return
		}
	}
{{- end}}
{{- if .ConfigTOML}}
	// Try TOML config
	if data, err := os.ReadFile(expandTilde({{goString .ConfigTOML}})); err == nil {
		var cfg map[string]any
		if _, err := toml.Decode(string(data), &cfg); err == nil {
			globalConfig = cfg
			return
		}
	}
{{- end}}
}

